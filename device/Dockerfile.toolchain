# Adapted from diskOS ui/Dockerfile (MIT; see licenses/diskos-tooling.MIT).
# Native companion cross-toolchain; asset embedding runs on the host.
# The base pinned by its digest (debian:12-slim, 2026-10-03); the compiler below by its SHA-256.
FROM --platform=linux/amd64 debian:12-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates make \
    && rm -rf /var/lib/apt/lists/*

# Static musl mipsel *soft-float* cross-toolchain (GCC 11.2.1, i386 host binaries, statically
# linked; same musl.cc family and date as the hard-float toolchain diskOS is built with).
# Soft float is required: the player's Linux 4.4.94 kernel emulates FP branch delay slots
# through a trampoline written to the user stack, which killed the hard-float companion
# inside CivetWeb's read_websocket on the first WebSocket (docs/combined-browser-observation.md).
# Pinned by SHA-256: if musl.cc changes the tarball the build fails loudly instead of
# drifting - update the checksum here when you intentionally bump the toolchain.
# musl.cc refuses some networks (GitHub's runners among them); the Internet Archive's copy of
# the same file (its 2024-03-16 capture, byte for byte the pinned one) is the fallback, checked
# by the same SHA-256. Nothing of the compiler is redistributed from these repositories.
ARG TC_URL=https://musl.cc/mipsel-linux-muslsf-cross.tgz
ARG TC_MIRROR=https://web.archive.org/web/20240316215615id_/https://musl.cc/mipsel-linux-muslsf-cross.tgz
ARG TC_SHA256=a61c3bbf9fbb0be80fe2abdb4ea8b6f5afdf664b5b4104a3784a326270905216
RUN { curl -fsSL --connect-timeout 20 "$TC_URL" -o /tmp/tc.tgz || curl -fsSL --retry 3 "$TC_MIRROR" -o /tmp/tc.tgz; } \
    && echo "$TC_SHA256  /tmp/tc.tgz" | sha256sum -c - \
    && tar -xzf /tmp/tc.tgz -C /opt \
    && rm /tmp/tc.tgz
ENV CROSS=/opt/mipsel-linux-muslsf-cross/bin/mipsel-linux-muslsf-

WORKDIR /src/device
CMD ["sh", "-c", "make OUT=../build/mips CC=${CROSS}gcc LDFLAGS=-static all"]
